{
  "hosting": {
    "site": "qltd-entiz-dev-208a3",
    "public": ".",
    "ignore": [
      "firebase.json",
      "package.json",
      "package-lock.json",
      "*.bak",
      "*.log",
      "node_modules/**",
      ".git/**"
    ],
    "headers": [
      {
